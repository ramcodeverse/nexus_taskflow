# Server-side (Railway/production)
GEMINI_API_KEY=your_gemini_api_key
# Railway runtime port will be injected automatically; keep server default as fallback.

# Firebase Admin (choose ONE approach)
# Approach A (preferred for server): set GOOGLE_APPLICATION_CREDENTIALS to a service account JSON file path
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Approach B: provide service account JSON directly (requires code support to parse env var)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

